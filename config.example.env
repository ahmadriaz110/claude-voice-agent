# Copy to ~/.voicemode/indicator/agent.env and source it in the launchd plists (EnvironmentVariables) or your shell.
# --- shared ---
AGENT_TZ=                               # IANA zone for every printed time (outgoings, digest, call watch), e.g. Europe/London; empty = the machine's zone
# --- inbox_hooks.py ---
INBOX_ME_EMAIL=you@example.com          # your mailbox
INBOX_ME_NAMES=jane,doe                 # lower-case name parts that identify you in mentions and display names (all must match)
INBOX_ME_WA_NAMES=jane doe              # your WhatsApp contact name(s) as seen from your own account, comma-separated (the other-phone check)
INBOX_ME_ALIASES=                       # extra group phrases that mean you were addressed ("jane doe,jane ji"); "@jane" is always one
INBOX_ME_ID=                            # your Entra user id (GET https://graph.microsoft.com/v1.0/me), matched against Teams mention ids
INBOX_ME_WA_IDS=                        # your own WhatsApp ids as they appear in @mentions (lid digits and/or phone digits), comma-separated
INBOX_OWN_DOMAIN=example.com            # replies from this domain count as "answered"
INBOX_TENANT=common                     # Entra tenant id, or "common"
INBOX_ESCALATE_TO=                      # second WhatsApp number, digits only (e.g. 4915551234567); empty disables escalation
INBOX_ESCALATE_AFTER=300                # seconds of no acknowledgement before a mail alert or sweep item goes to the second phone
INBOX_MAIL_FOLDERS=Inbox,Clients        # folders to subscribe to (names)
INBOX_CLIENT_FOLDERS=Clients            # folders where every external mail counts as a client request for the sweep
INBOX_CLIENT_DOMAINS=                   # client mail domains, never treated as vendor offers (comma-separated)
INBOX_VENDOR_DOMAINS=                   # supplier / partner domains whose mails carry no reply SLA (comma-separated)
INBOX_VENDOR_WORDS=                     # extra lower-case phrases that mark a supplier offer ("our monthly rate")
INBOX_SYSTEM_SENDERS=no-reply@,noreply@,mailer-daemon,donotreply@   # address prefixes that are systems, not people
INBOX_SYSTEM_PHRASES=                   # lower-case phrases that mark a portal notice as system mail ("pre-billing file has been")
INBOX_CHAT_TOP=50                       # most-recently-active Teams chats to subscribe to
INBOX_QUOTE_SLA_H=2                     # hours before an unanswered client request is flagged
INBOX_READ_GRACE_S=75                   # seconds to wait before injecting a chat item, in case you read it yourself first
INBOX_OWN_POST_WINDOW_S=86400           # a group reply within this many seconds of your own post counts as a thread you opened
INBOX_MENTION_AFTER_S=600               # a sender's follow-ups within this window after tagging you stay important
INBOX_MENTION_BEFORE_S=180              # on a tag, that sender's messages from this many seconds before are attached
INBOX_WHISPER_URL=http://127.0.0.1:2022/v1/audio/transcriptions
WA_DAEMON_URL=http://127.0.0.1:47823
INBOX_PORT=8898
# --- bargein_daemon.py ---
BARGEIN_WAKE_STT=http://127.0.0.1:2022/v1/audio/transcriptions
BARGEIN_HOME_SESSION=Code>My voice session   # sidebar path to return to after a named-session command
BARGEIN_MIC_NAME=USB                    # substring of your headset's input device name
BARGEIN_SPEAKER_THRESHOLD=0.60          # resemblyzer print (fallback only)
BARGEIN_WAKE_SPK=0.55
BARGEIN_SPEAKER_THRESHOLD_ECAPA=0.33    # ECAPA print: absolute bar for an interrupt
BARGEIN_WAKE_THRESHOLD_ECAPA=0.30       # ECAPA print: bar for the wake word
BARGEIN_REL_MIN=0.50                    # accept if you score at least this AND beat the TTS by REL_MARGIN
BARGEIN_REL_MARGIN=0.04
BARGEIN_REL2_MIN=0.22                   # looser tier: accept sooner when you clearly beat the TTS
BARGEIN_REL2_MARGIN=0.15
BARGEIN_CUT_TTS_WINDOW=30               # seconds after an injection during which in-flight speech is cut
BARGEIN_NOTIFY_WA=                      # your second WhatsApp number, digits only; the daemon messages it when a paste cannot be delivered for 15 min
BARGEIN_WA_SEND_URL=http://127.0.0.1:47823/send
BARGEIN_RETRY_EVERY=30                  # seconds between paste retries
BARGEIN_RETRY_MAX=30                    # retries before giving up and notifying
BARGEIN_PASTE_FOREGROUND=0              # 1 = bring Claude to the front to paste (old behaviour); 0 = deliver in the background
INBOX_DELIVERY_WATCH_S=90               # receiver: seconds to wait for the daemon's delivery marker before telling the user
# --- call_watch.py ---
CALLWATCH_WHISPER_URL=http://127.0.0.1:2022/v1/audio/transcriptions   # OpenAI-shaped endpoint for call transcripts (a LAN large-v3 box if you have one)
CALLWATCH_MIC=                          # substring of the headset input device name to record; empty = default input
CALLWATCH_START_AFTER_S=20              # seconds of mic+output before it counts as a call (voice notes stay under this)
CALLWATCH_END_AFTER_S=8                 # seconds without mic input that end the call
CALLWATCH_CHUNK_S=600                   # recording chunk length
CALLWATCH_PIECE_S=90                    # seconds per whisper upload
CALLWATCH_REQUIRE_OUTPUT=1              # 0 = mic input alone counts as a call
CALLWATCH_MIN_SPEECH_S=6                # pieces with less detected speech than this are not sent to whisper (hallucination guard)
# --- dns_fallback.py (imported by inbox_hooks.py, call_watch.py, outgoings.py) ---
DNS_DOH_URL=https://1.1.1.1/dns-query?name=%s&type=A   # DoH endpoint reached by IP, must answer application/dns-json
DNS_FAIL_WINDOW_S=120                   # after one resolver failure, go DoH-first for this long
DNS_CACHE_S=300
# --- send_mail.py / mail_html.py ---
MAIL_SIGNATURE_FILE=                    # default ~/.voicemode/templates/signature.html (your signature block's HTML, private)
MAIL_SIGNATURE_MARKER=                  # a string that must appear in the template (your surname in capitals); send_mail refuses otherwise
MAIL_SIG_NAME=                          # mail_html.py fallback block when the template is missing
MAIL_SIG_TITLE=
MAIL_SIG_PHONE=
MAIL_SIG_EMAIL=
MAIL_SIG_WEB=
# --- outgoings.py ---
OUTGOINGS_AGENT_PREFIXES=[AI],Claude:   # message prefixes the agent uses when it posts as you; skipped as "not your words"
OUTGOINGS_WATCH_WINDOW_MIN=4            # outgoings_watch.py: minutes of history re-read on every tick
PRESENCE_FILE=                          # default ~/.voicemode/presence.json (the menu bar At desk / Away toggle); the watch sleeps while Away
# --- tasks.py ---
TASKS_PENDING_MD=                       # default ~/.voicemode/context/Pending.md; the open items by priority, rendered on every save
# --- heal_voicemode.py ---
HEAL_KOKORO_URL=http://127.0.0.1:8880/v1/audio/speech
HEAL_KOKORO_VOICE=af_sky                # voice used for the two-minute mute probe
# --- voice-mode (~/.voicemode/voicemode.env) ---
VOICEMODE_SILENCE_THRESHOLD_MS=1800     # end a take after this much silence (1200 cuts people who pause to think)
VOICEMODE_SPEAKER_REJECT=0              # the listen-window speaker filter; leave off, the daemon verifies instead
VOICEMODE_KOKORO_MAX_REQUESTS=1000000   # the Kokoro plist template sets 25 and uvicorn exits after that many requests
# --- other knobs the code reads (defaults in the source) ---
