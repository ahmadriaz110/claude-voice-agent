+# --- speaker-gated end-of-turn -------------------------------------------
+# Plain VAD keeps a recording open for ANY sound, so a noisy room never yields
+# the quiet needed to end a turn. These ask the barge-in daemon (which holds a
+# warm voiceprint model) whether recent audio is actually the enrolled speaker.
+_VM_SPEAKER_GATE = True
+_VM_VERIFY_URL = "http://127.0.0.1:8899/"
+_VM_RECORDING_FLAG = Path.home() / ".voicemode" / "indicator" / "vm_recording.flag"
+_VM_SPEAKER_MIN = 0.50
+# Speaker FILTER on the listen window. Wake and barge-in are already locked to
+# the enrolled voice, but the reply window recorded whoever spoke: a bystander
+# or a TV could land as the user's answer. Score the whole take; below this
+# similarity it is dropped and we listen again (at most _MAX times per turn).
+# Measured 2026-09-06: the user's voice 0.99 clean / 0.58-0.69 over TTS, a video in
+# the room 0.45-0.52, one other speaker in it 0.57-0.79 on 1-3s bursts.
+_VM_SPEAKER_REJECT = os.environ.get("VOICEMODE_SPEAKER_REJECT", "1") not in ("0", "false", "False")
+_VM_SPEAKER_REJECT_MIN = float(os.environ.get("VOICEMODE_SPEAKER_REJECT_MIN", 0.55))
+_VM_SPEAKER_REJECT_MAX = int(os.environ.get("VOICEMODE_SPEAKER_REJECT_MAX", 2))
+
+
+def _vm_verify_speaker(pcm_bytes: bytes):
+    """Similarity to the enrolled voiceprint, or None if undeterminable.
+
+    None means 'could not tell' (daemon down, no voiceprint). Callers MUST fall
+    back to existing behaviour on None - failing closed would silently discard
+    real speech, which is worse than a long recording.
+    """
+    try:
+        import urllib.request
+        req = urllib.request.Request(_VM_VERIFY_URL, data=pcm_bytes,
+                                     headers={"Content-Type": "application/octet-stream"})
+        with urllib.request.urlopen(req, timeout=1.5) as r:
+            v = float(r.read().decode().split()[0])
+        return None if v < 0 else v
+    except Exception:
+        return None
