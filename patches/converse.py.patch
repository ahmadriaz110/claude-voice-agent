+def _consume_bargein_preroll(rate: int):
+    """Return audio captured by the barge-in daemon just before it interrupted.
+
+    When voice barge-in fires, the daemon has already been holding the mic and
+    has heard the opening of the sentence that triggered it. It then closes the
+    mic so VoiceMode can record, and VoiceMode starts from scratch - losing
+    everything spoken during the handover. (Observed: an interruption arriving
+    as only "and many more".)
+
+    The daemon writes what it heard to a wav; we prepend it here and delete it,
+    so it is consumed exactly once. Stale files are ignored rather than
+    prepended to an unrelated turn.
+    """
+    try:
+        if not _BARGEIN_PREROLL.exists():
+            return None
+        age = time.time() - _BARGEIN_PREROLL.stat().st_mtime
+        if age > _BARGEIN_PREROLL_MAX_AGE:
+            _BARGEIN_PREROLL.unlink(missing_ok=True)
+            logger.debug("barge-in preroll ignored (stale: %.1fs)", age)
+            return None
+        with wave.open(str(_BARGEIN_PREROLL), "rb") as w:
+            if w.getframerate() != rate or w.getnchannels() != 1 or w.getsampwidth() != 2:
+                logger.warning("barge-in preroll format mismatch; ignoring")
+                _BARGEIN_PREROLL.unlink(missing_ok=True)
+                return None
+            data = w.readframes(w.getnframes())
+        _BARGEIN_PREROLL.unlink(missing_ok=True)
+        arr = np.frombuffer(data, dtype=np.int16).reshape(-1, 1)
+        logger.info("barge-in preroll prepended: %.2fs", len(arr) / rate)
+        return arr
+    except Exception as e:
+        logger.warning("barge-in preroll failed: %s", e)
+        try:
+            _BARGEIN_PREROLL.unlink(missing_ok=True)
+        except Exception:
+            pass
+        return None
 
 
